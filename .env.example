# PocketHunter-Suite Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================
# Redis Configuration
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# Postgres (v2 Phase A) — required
# ============================================
# Driver+DSN consumed by SQLAlchemy. Inside docker-compose the host is
# "postgres"; for local-host development point at "localhost".
DATABASE_URL=postgresql+psycopg://pockethunter:pockethunter@postgres:5432/pockethunter

# ============================================
# Shareable Session URLs (v2 Phase A) — required
# ============================================
# Public base URL used to generate /s/<short>?edit=<secret> share links.
# No fallback — the app refuses to start without this.
BASE_URL=http://localhost:8501

# ============================================
# Application Directories (optional)
# ============================================
# Leave commented to use defaults (./uploads and ./results)
# Use absolute paths for production deployments
#UPLOAD_DIR=/absolute/path/to/uploads
#RESULTS_DIR=/absolute/path/to/results

# ============================================
# File Upload Limits
# ============================================
# File sizes in bytes
MAX_UPLOAD_SIZE=524288000  # 500 MB (default)
MAX_ZIP_SIZE=1073741824    # 1 GB (default)

# ============================================
# Resource Management
# ============================================
# Delete job directories older than this many days
CLEANUP_AFTER_DAYS=30

# Maximum disk space for uploads + results (in GB)
MAX_DISK_USAGE_GB=100

# ============================================
# Worker & Compute Tuning
# ============================================
# Celery worker concurrency (max simultaneous jobs per queue). Read by
# docker-compose's worker `command:` lines — must be set here in .env
# for compose to interpolate them.
WORKER_CONCURRENCY=8        # pipeline queue (find_pockets / cluster)
DOCKING_CONCURRENCY=4       # docking queue

# p2rank thread count for the detect_pockets stage (not user-facing).
P2RANK_THREADS=4

# ============================================
# Docking Limits
# ============================================
# Fixed smina exhaustiveness — not user-facing (no slider in the UI).
DOCKING_EXHAUSTIVENESS=8

# Max ligand×pocket pairs per docking run. An uploaded SDF is rejected
# when (molecules × selected pockets) exceeds this.
DOCKING_MAX_PAIRS=1000

# Cap on the on-demand "all docking results" ZIP download, in bytes.
MAX_DOWNLOAD_ZIP_SIZE=536870912  # 512 MB

# Max representative PDBs (pockets) accepted per docking run.
#MAX_DOCKING_PDBS=20

# Docking task hard timeout, in seconds.
#DOCKING_TIMEOUT=7200

# ============================================
# Logging Configuration
# ============================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (leave commented for default: ./pockethunter-suite.log)
#LOG_FILE=/var/log/pockethunter-suite/app.log

# ============================================
# Rate Limiting
# ============================================
# Set to false to disable rate limiting (useful for local development)
RATE_LIMIT_ENABLED=true

# Maximum uploads per time window
RATE_LIMIT_MAX_UPLOADS=10

# Upload rate limit window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum task submissions per time window
RATE_LIMIT_MAX_TASKS=5

# Task rate limit window in seconds
RATE_LIMIT_TASK_WINDOW_SECONDS=60

# ============================================
# External Tools (Advanced)
# ============================================
# Paths to external binaries (optional, will use PATH if not specified)
#P2RANK_PATH=/path/to/p2rank/prank
#SMINA_PATH=/path/to/smina
