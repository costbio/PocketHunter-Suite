# PocketHunter-Suite Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================
# Redis Configuration
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# Postgres (v2 Phase A) — required
# ============================================
# Password the Postgres container provisions itself with (and that
# DATABASE_URL embeds). REQUIRED — docker compose refuses to start
# without it. Generate a strong one:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Driver+DSN consumed by SQLAlchemy. Inside docker-compose the host is
# "postgres"; for local-host development point at "localhost". The
# password placeholder below is substituted by docker compose from the
# POSTGRES_PASSWORD line above — don't hard-code it here.
DATABASE_URL=postgresql+psycopg://pockethunter:${POSTGRES_PASSWORD}@postgres:5432/pockethunter

# Where Postgres stores its data on the HOST. Bind-mounted into the
# postgres container at /var/lib/postgresql/data. Default ./pgdata
# keeps the data next to the source so you can `ls`, `tar` (back up),
# or `rm -rf` (wipe + reinit) without `docker volume` plumbing.
# Production deployments may want a dedicated mount, e.g.
# /var/lib/pockethunter/pgdata on a data disk.
#
# Caveat: don't pre-create the directory. Postgres' entrypoint runs
# initdb + chowns to UID 70 on first boot; a pre-existing dir owned
# by the host user blocks that.
POSTGRES_DATA_DIR=./pgdata

# ============================================
# Shareable Session URLs (v2 Phase A) — required
# ============================================
# Public base URL used to generate /s/<short>?edit=<secret> share links.
# No fallback — the app refuses to start without this.
BASE_URL=http://localhost:8501

# Reverse-proxy hostname Caddy serves on. Consumed ONLY by the shipped
# Caddyfile.example via {$DOMAIN}; the suite itself reads BASE_URL above.
# Leave commented for local-dev — Caddy isn't running.
# DOMAIN=app.example.com

# ============================================
# Demo data (landing-page "Try with example trajectory" button)
# ============================================
# Host directory containing ``trajectory.xtc`` + ``topology.gro``.
# Default is EMPTY — the demo button is hidden on fresh clones because
# ./examples/ is gitignored (the trypsin demo is large data that's
# carried to deploy hosts out-of-band, not in the repo). To enable the
# demo, drop the two files at e.g. ./examples/trypsin/ and set this to
# ./examples/trypsin. Filenames must be exactly trajectory.xtc +
# topology.gro — no auto-detect.
# Path to example trajectory for the landing-page demo button.
# Set to a directory containing "trajectory.xtc" + "topology.pdb" (or .gro).
# Default when examples are bundled: /app/examples/trypsin
EXAMPLE_TRAJECTORY_DIR=

# ============================================
# Cloudflare Turnstile CAPTCHA (Phase D)
# ============================================
# Second line of defence against scripted session-create abuse on top of
# the per-IP daily cap (MAX_SESSIONS_PER_IP_PER_DAY). The defaults below
# DISABLE CAPTCHA — fine for local dev, NOT fine for a public deploy.
# Before pointing DNS at the box, set TURNSTILE_ENABLED=true and populate
# both keys. Get them at: https://www.cloudflare.com/products/turnstile/
#
# WARNING: leaving CAPTCHA disabled on a public deploy means the only
# barrier against scripted abuse is the MAX_SESSIONS_PER_IP_PER_DAY cap,
# which a botnet with thousands of IPs trivially defeats.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================
# Application Directories (optional)
# ============================================
# Leave commented to use defaults (./uploads and ./results)
# Use absolute paths for production deployments
#UPLOAD_DIR=/absolute/path/to/uploads
#RESULTS_DIR=/absolute/path/to/results

# ============================================
# File Upload Limits
# ============================================
# File sizes in bytes
MAX_UPLOAD_SIZE=524288000  # 500 MB (default)
MAX_ZIP_SIZE=1073741824    # 1 GB (default)

# ============================================
# Resource Management
# ============================================
# Delete job directories older than this many days
CLEANUP_AFTER_DAYS=30

# Maximum disk space for uploads + results (in GB)
MAX_DISK_USAGE_GB=100

# ============================================
# Worker & Compute Tuning
# ============================================
# Celery worker concurrency (max simultaneous jobs per queue). Read by
# docker-compose's worker `command:` lines — must be set here in .env
# for compose to interpolate them.
WORKER_CONCURRENCY=8        # pipeline queue (find_pockets / cluster)
DOCKING_CONCURRENCY=4       # docking queue

# p2rank thread count for the detect_pockets stage (not user-facing).
P2RANK_THREADS=4

# ============================================
# Docking Limits
# ============================================
# Fixed smina exhaustiveness — not user-facing (no slider in the UI).
DOCKING_EXHAUSTIVENESS=8

# Max ligand×pocket pairs per docking run. An uploaded SDF is rejected
# when (molecules × selected pockets) exceeds this.
DOCKING_MAX_PAIRS=1000

# Cap on the on-demand "all docking results" ZIP download, in bytes.
MAX_DOWNLOAD_ZIP_SIZE=536870912  # 512 MB

# Maximum trajectory frames the viewer is willing to render. Above this,
# browser memory + WebGL trajectory upload reliably fall over on consumer
# laptops even when the on-disk multi-model PDB fits MAX_VIEWER_BYTES.
# find_pockets refuses ZIP uploads over this count; trajectory uploads
# fail the job after extract with a "raise stride to N" hint.
MAX_TRAJECTORY_FRAMES=1000

# Hard cap on the raw byte size of the viewer file (multi-model PDB / mmCIF)
# the worker is willing to build. Protects against pathological inputs
# (e.g. solvated MD frames with 100k+ atoms each) that would slug the
# browser regardless of frame count. Complementary to MAX_TRAJECTORY_FRAMES:
# the latter caps frame *count*, this caps per-frame size × count.
MAX_VIEWER_BYTES=1073741824  # 1 GB

# Cap on how many extracted PDBs are baked into viewer.pdb as models. The
# viewer applies a uniform stride at build time when the extracted count
# exceeds this; the per-frame PDBs outside the strided set stay on disk
# and load on demand (single-frame mode) when a user picks them via a
# pocket / cluster rep / docking receptor row. Independent of
# MAX_TRAJECTORY_FRAMES — pocket detection still runs on every extracted
# frame regardless of what the viewer ends up showing.
MAX_VIEWER_LOADED_FRAMES=200

# ============================================
# Phase C — Worker pools & abuse limits
# ============================================
# Bounded hardened worker pools managed by the orchestrator service.
# `fast_pool` serves the find_pockets / cluster / pipeline queue;
# `docking_pool` serves the docking queue. Separate pools so slow
# docking jobs can't starve quick pipeline ones.
#
# C1 only scaffolds these knobs; the orchestrator that consumes them
# arrives in C2. The legacy celery-worker / celery-docking-worker
# services keep running off WORKER_CONCURRENCY / DOCKING_CONCURRENCY
# above for one release of back-compat.
FAST_POOL_SIZE=6           # workers on default queue
DOCKING_POOL_SIZE=3        # workers on docking queue

# Per-worker container resource caps.
WORKER_CPU_LIMIT=6         # --cpus
WORKER_MEMORY_LIMIT=12g    # --memory

# Defence-in-depth: tear down + replace a worker after K jobs.
WORKER_JOBS_BEFORE_RECYCLE=10

# Seconds to wait for a worker to finish its in-flight task during a
# recycle before SIGKILL. SIGTERM triggers celery's warm shutdown so the
# task completes cleanly. Defaults to DOCKING_TIMEOUT (2 h) so a docking
# pair is never cut short by recycle.
WORKER_DRAIN_TIMEOUT=7200

# Worker image tag the orchestrator spawns from.
WORKER_IMAGE_TAG=pockethunter-worker:latest

# Orchestrator backend — single-box uses Docker SDK; the k8s seam is a stub.
ORCHESTRATOR_BACKEND=docker_sdk

# Per-session caps (so one user can't monopolise a pool).
PER_SESSION_DISK_QUOTA_MB=5000
MAX_CONCURRENT_FAST_JOBS=60
MAX_CONCURRENT_DOCKING_JOBS=30
MAX_CONCURRENT_FAST_PER_SESSION=2
MAX_CONCURRENT_DOCKING_PER_SESSION=1

# Per-IP daily cap on COMMITTED sessions — sessions where the user
# actually dispatched at least one job (find_pockets / cluster /
# docking). Empty sessions (created but never used) are forgiven AND
# auto-deleted by the cleanup_abandoned_sessions beat task, so they
# don't burn the visitor's quota.
MAX_SESSIONS_PER_IP_PER_DAY=20

# How long an empty (no-jobs) session is allowed to live before the
# cleanup beat task may delete it. Does NOT affect rate-limit counts —
# empty sessions never count toward MAX_SESSIONS_PER_IP_PER_DAY. The
# grace exists only to keep a brand-new session around long enough
# that a user mid-upload isn't yanked out from under them by the
# cleanup loop.
SESSION_GRACE_MINUTES=15

# ── Phase C C2 — orchestrator runtime ────────────────────────────────
# Master toggle. After the C3 cut-over the orchestrator is the only
# source of worker containers — the legacy celery-worker /
# celery-docking-worker services are gone. Setting USE_ORCHESTRATOR=false
# now means *no workers at all* (HTTP API still runs).
USE_ORCHESTRATOR=true

# Docker SDK reaches the daemon through the in-network socket proxy.
# Override to unix:///var/run/docker.sock for local single-process tests.
DOCKER_PROXY_URL=tcp://docker-proxy:2375

# Orchestrator HTTP API port (mounted to host as 9001 for inspection).
ORCHESTRATOR_HTTP_PORT=9000

# Reconcile loop period: recycle trigger + orphan reap cadence.
ORCHESTRATOR_TICK_SECONDS=30

# Internal Docker network workers attach to (no public egress).
WORKER_NETWORK_NAME=pockethunter_internal

# Max representative PDBs (pockets) accepted per docking run.
#MAX_DOCKING_PDBS=20

# Docking task hard timeout, in seconds. Default 7200 (2 h). Raise for
# very-high-exhaustiveness runs; lower to keep workers from being held
# indefinitely by a single stuck pair.
DOCKING_TIMEOUT=7200

# Max number of ligands accepted per docking run (multi-SDF upload).
MAX_DOCKING_LIGANDS=10

# Hard ceiling on the user-facing exhaustiveness control. The default
# above (DOCKING_EXHAUSTIVENESS=8) sets the actual value used; this is
# only the cap that the UI slider tops out at if you re-enable it.
MAX_DOCKING_EXHAUSTIVENESS=12

# ============================================
# Logging Configuration
# ============================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location. Default below is the Docker-aware path — the
# streamlit + worker + orchestrator containers all bind-mount ./logs/
# to /app/logs, and the host-side logrotate config (see
# docs/deployment.md §7) rotates /path/to/repo/logs/pockethunter-suite.log.
# Override for a bare-host install (no Docker) to e.g.
# /var/log/pockethunter-suite/app.log + adjust the rotate config.
LOG_FILE=/app/logs/pockethunter-suite.log

# ============================================
# Rate Limiting
# ============================================
# Set to false to disable rate limiting (useful for local development)
RATE_LIMIT_ENABLED=true

# Maximum uploads per time window
RATE_LIMIT_MAX_UPLOADS=10

# Upload rate limit window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum task submissions per time window
RATE_LIMIT_MAX_TASKS=5

# Task rate limit window in seconds
RATE_LIMIT_TASK_WINDOW_SECONDS=60

# ============================================
# External Tools (Advanced)
# ============================================
# Paths to external binaries (optional, will use PATH if not specified)
#P2RANK_PATH=/path/to/p2rank/prank
#SMINA_PATH=/path/to/smina
